BOT_TOKEN=

ADMIN_ID=

OPENROUTER_API_KEY=

AI_PROVIDER=openrouter

MODEL=openrouter/free

TIMEZONE=Europe/Moscow
DATABASE_URL=sqlite+aiosqlite:///data/morning_companion.db

# HTTP proxy for Telegram / OpenRouter (required if the network blocks direct access).
# Leave empty to connect directly.
PROXY=

# How long to keep messages in the database, in days.
MESSAGE_RETENTION_DAYS=365

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to block everyone.
ALLOWED_USERS=123456789

# Critical event alerts: notify the admin when a user reports a health emergency
# (e.g. "I called an ambulance", "I can't breathe", "I feel very bad").
CRITICAL_ALERT_ENABLED=true
# Minimum severity that triggers an admin alert: low, high, or critical.
CRITICAL_ALERT_MIN_SEVERITY=high
# Cooldown between admin alerts for the same user, in minutes.
CRITICAL_ALERT_COOLDOWN_MINUTES=120
